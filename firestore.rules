rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Hardened Primitives
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'shettyharikrishna1@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmail(email) {
      return email is string && email.size() >= 3 && email.size() <= 200 && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ---------------------------------------------------------
    // Entity Validation Blueprints (Anti-Update-Gap)
    // ---------------------------------------------------------
    function isValidStockMap(stock) {
      return stock is map
        && stock.keys().hasAll(['XS', 'S', 'M', 'L', 'XL'])
        && stock.keys().hasOnly(['XS', 'S', 'M', 'L', 'XL'])
        && stock.XS is int && stock.XS >= 0 && stock.XS <= 100000
        && stock.S is int && stock.S >= 0 && stock.S <= 100000
        && stock.M is int && stock.M >= 0 && stock.M <= 100000
        && stock.L is int && stock.L >= 0 && stock.L <= 100000
        && stock.XL is int && stock.XL >= 0 && stock.XL <= 100000;
    }

    function isValidShowroomViews(views) {
      return views is map
        && views.keys().hasAll(['front', 'right', 'back', 'left'])
        && views.keys().hasOnly(['front', 'right', 'back', 'left'])
        && views.front is string && views.front.size() >= 1 && views.front.size() <= 500
        && views.right is string && views.right.size() >= 1 && views.right.size() <= 500
        && views.back is string && views.back.size() >= 1 && views.back.size() <= 500
        && views.left is string && views.left.size() >= 1 && views.left.size() <= 500;
    }

    function isValidSpecs(specs) {
      return specs is map
        && specs.keys().hasAll(['fabric', 'weight', 'origin', 'fit', 'modelNote', 'care'])
        && specs.keys().hasOnly(['fabric', 'weight', 'origin', 'fit', 'modelNote', 'care'])
        && specs.fabric is string && specs.fabric.size() >= 1 && specs.fabric.size() <= 160
        && specs.weight is string && specs.weight.size() >= 1 && specs.weight.size() <= 120
        && specs.origin is string && specs.origin.size() >= 1 && specs.origin.size() <= 160
        && specs.fit is string && specs.fit.size() >= 1 && specs.fit.size() <= 160
        && specs.modelNote is string && specs.modelNote.size() >= 1 && specs.modelNote.size() <= 160
        && specs.care is string && specs.care.size() >= 1 && specs.care.size() <= 200;
    }

    function isValidMeasurementEntry(m) {
      return m is map
        && m.keys().hasAll(['chest', 'length', 'shoulder', 'sleeve'])
        && m.keys().hasOnly(['chest', 'length', 'shoulder', 'sleeve'])
        && m.chest is number && m.chest >= 40 && m.chest <= 250
        && m.length is number && m.length >= 30 && m.length <= 200
        && m.shoulder is number && m.shoulder >= 25 && m.shoulder <= 120
        && m.sleeve is number && m.sleeve >= 10 && m.sleeve <= 120;
    }

    function isValidMeasurements(ms) {
      return ms is map
        && ms.keys().hasAll(['XS', 'S', 'M', 'L', 'XL'])
        && ms.keys().hasOnly(['XS', 'S', 'M', 'L', 'XL'])
        && isValidMeasurementEntry(ms.XS)
        && isValidMeasurementEntry(ms.S)
        && isValidMeasurementEntry(ms.M)
        && isValidMeasurementEntry(ms.L)
        && isValidMeasurementEntry(ms.XL);
    }

    function isValidProduct(data, productId) {
      return data.keys().hasAll([
          'id', 'sku', 'name', 'priceUsd', 'costUsd', 'category', 'color',
          'tagline', 'description', 'status', 'showroomImage', 'showroomViews',
          'productImage', 'sizes', 'stock', 'lowStockThreshold', 'isNewArrival',
          'isBestseller', 'pairWithIds', 'outfitPairings', 'specs', 'measurements',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'sku', 'name', 'priceUsd', 'costUsd', 'category', 'color',
          'tagline', 'description', 'status', 'showroomImage', 'showroomViews',
          'productImage', 'sizes', 'stock', 'lowStockThreshold', 'isNewArrival',
          'isBestseller', 'pairWithIds', 'outfitPairings', 'specs', 'measurements',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == productId && data.id.size() >= 1 && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.sku is string && data.sku.size() >= 2 && data.sku.size() <= 32 && data.sku.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.priceUsd is number && data.priceUsd >= 0 && data.priceUsd <= 100000
        && data.costUsd is number && data.costUsd >= 0 && data.costUsd <= 100000
        && data.category in ['Tops', 'Outerwear']
        && data.color is string && data.color.size() >= 1 && data.color.size() <= 80
        && data.tagline is string && data.tagline.size() >= 1 && data.tagline.size() <= 240
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 1200
        && data.status in ['active', 'draft', 'archived']
        && data.showroomImage is string && data.showroomImage.size() >= 1 && data.showroomImage.size() <= 500
        && isValidShowroomViews(data.showroomViews)
        && data.productImage is string && data.productImage.size() >= 1 && data.productImage.size() <= 500
        && data.sizes is list && data.sizes.size() >= 1 && data.sizes.size() <= 5 && data.sizes.hasOnly(['XS', 'S', 'M', 'L', 'XL'])
        && isValidStockMap(data.stock)
        && data.lowStockThreshold is int && data.lowStockThreshold >= 0 && data.lowStockThreshold <= 1000
        && data.isNewArrival is bool
        && data.isBestseller is bool
        && data.pairWithIds is list && data.pairWithIds.size() <= 6 && (data.pairWithIds.size() == 0 || (data.pairWithIds[0] is string && data.pairWithIds[0].size() <= 64))
        && data.outfitPairings is list && data.outfitPairings.size() <= 6 && (data.outfitPairings.size() == 0 || data.outfitPairings[0] is map)
        && isValidSpecs(data.specs)
        && isValidMeasurements(data.measurements)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'name', 'email', 'photoURL', 'role', 'tier', 'status',
          'ordersCount', 'totalSpentUsd', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'email', 'photoURL', 'role', 'tier', 'status',
          'ordersCount', 'totalSpentUsd', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && isValidEmail(data.email)
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.role in ['admin', 'manager', 'customer']
        && data.tier in ['Studio Member', 'VIP Member', 'Staff']
        && data.status in ['active', 'suspended']
        && data.ordersCount is int && data.ordersCount >= 0 && data.ordersCount <= 100000
        && data.totalSpentUsd is number && data.totalSpentUsd >= 0 && data.totalSpentUsd <= 10000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && isValidEmail(data.email)
        && data.grantedBy is string && isValidId(data.grantedBy)
        && data.createdAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderNumber', 'userId', 'email', 'shippingName', 'shippingAddress',
          'items', 'subtotalUsd', 'shippingUsd', 'totalUsd', 'currency',
          'status', 'trackingNumber', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderNumber', 'userId', 'email', 'shippingName', 'shippingAddress',
          'items', 'subtotalUsd', 'shippingUsd', 'totalUsd', 'currency',
          'status', 'trackingNumber', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 32 && data.orderNumber.matches('^[A-Z0-9\\-]+$')
        && data.userId is string && isValidId(data.userId)
        && isValidEmail(data.email)
        && data.shippingName is string && data.shippingName.size() >= 1 && data.shippingName.size() <= 120
        && data.shippingAddress is string && data.shippingAddress.size() >= 1 && data.shippingAddress.size() <= 300
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 25 && data.items[0] is map
        && data.subtotalUsd is number && data.subtotalUsd >= 0 && data.subtotalUsd <= 1000000
        && data.shippingUsd is number && data.shippingUsd >= 0 && data.shippingUsd <= 10000
        && data.totalUsd is number && data.totalUsd >= 0 && data.totalUsd <= 1010000
        && data.currency in ['USD', 'CAD']
        && data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled', 'refunded']
        && data.trackingNumber is string && data.trackingNumber.size() <= 80
        && data.notes is string && data.notes.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInventoryLog(data) {
      return data.keys().hasAll([
          'productId', 'productName', 'size', 'previousQty', 'delta', 'newQty',
          'reason', 'note', 'actorUid', 'actorName', 'createdAt'
        ])
        && data.keys().hasOnly([
          'productId', 'productName', 'size', 'previousQty', 'delta', 'newQty',
          'reason', 'note', 'actorUid', 'actorName', 'createdAt'
        ])
        && data.productId is string && isValidId(data.productId)
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 120
        && data.size in ['XS', 'S', 'M', 'L', 'XL']
        && data.previousQty is int && data.previousQty >= 0 && data.previousQty <= 100000
        && data.delta is int && data.delta >= -100000 && data.delta <= 100000
        && data.newQty is int && data.newQty >= 0 && data.newQty <= 100000
        && data.newQty == data.previousQty + data.delta
        && data.reason in ['restock', 'sale', 'adjustment', 'return', 'damaged']
        && data.note is string && data.note.size() <= 240
        && data.actorUid is string && data.actorUid == request.auth.uid
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll([
          'storeName', 'announcementText', 'announcementEnabled',
          'freeDeliveryThresholdUsd', 'standardShippingUsd', 'cadExchangeRate',
          'lowStockDefaultThreshold', 'supportEmail', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'storeName', 'announcementText', 'announcementEnabled',
          'freeDeliveryThresholdUsd', 'standardShippingUsd', 'cadExchangeRate',
          'lowStockDefaultThreshold', 'supportEmail', 'updatedAt'
        ])
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80
        && data.announcementText is string && data.announcementText.size() <= 200
        && data.announcementEnabled is bool
        && data.freeDeliveryThresholdUsd is number && data.freeDeliveryThresholdUsd >= 0 && data.freeDeliveryThresholdUsd <= 10000
        && data.standardShippingUsd is number && data.standardShippingUsd >= 0 && data.standardShippingUsd <= 500
        && data.cadExchangeRate is number && data.cadExchangeRate >= 0.1 && data.cadExchangeRate <= 10
        && data.lowStockDefaultThreshold is int && data.lowStockDefaultThreshold >= 0 && data.lowStockDefaultThreshold <= 500
        && isValidEmail(data.supportEmail)
        && data.updatedAt is timestamp;
    }

    // ---------------------------------------------------------
    // 1. Products & Per-Size Inventory (/products/{productId})
    // ---------------------------------------------------------
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;

      allow create: if isVerifiedUser()
        && isValidId(productId)
        && isValidProduct(incoming(), productId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isVerifiedUser()
        && isValidId(productId)
        && isValidProduct(incoming(), productId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'sku', 'name', 'priceUsd', 'costUsd', 'category', 'color',
            'tagline', 'description', 'status', 'showroomImage', 'showroomViews',
            'productImage', 'sizes', 'stock', 'lowStockThreshold', 'isNewArrival',
            'isBestseller', 'pairWithIds', 'outfitPairings', 'specs', 'measurements',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedUser() && isValidId(productId) && isAdmin();
    }

    // ---------------------------------------------------------
    // 2. Users & RBAC Profiles (/users/{userId}) - PII Protected
    // ---------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            isOwner(userId)
            && incoming().role == 'customer'
            && incoming().tier == 'Studio Member'
            && incoming().status == 'active'
            && incoming().ordersCount == 0
            && incoming().totalSpentUsd == 0
          )
          ||
          isAdmin()
        );

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'email', 'photoURL', 'role', 'tier', 'status', 'ordersCount', 'totalSpentUsd', 'updatedAt'
            ])
          )
          ||
          (
            isOwner(userId)
            && existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoURL', 'updatedAt'])
          )
        );

      allow delete: if isVerifiedUser() && isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }

    // ---------------------------------------------------------
    // 3. Trusted Admin Registry (/admins/{userId})
    // ---------------------------------------------------------
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidAdminRecord(incoming(), userId)
        && incoming().grantedBy == request.auth.uid
        && incoming().createdAt == request.time
        && isAdmin();

      allow update: if false;

      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && isAdmin()
        && userId != request.auth.uid;
    }

    // ---------------------------------------------------------
    // 4. Customer Orders (/orders/{orderId}) - PII Protected
    // ---------------------------------------------------------
    match /orders/{orderId} {
      allow get: if isSignedIn()
        && isValidId(orderId)
        && (existing().userId == request.auth.uid || isAdmin());

      allow list: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            incoming().userId == request.auth.uid
            && incoming().status == 'pending'
            && incoming().trackingNumber == ''
          )
          || isAdmin()
        );

      allow update: if isVerifiedUser()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().userId == existing().userId
        && incoming().orderNumber == existing().orderNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'trackingNumber', 'notes', 'shippingAddress', 'shippingName', 'updatedAt'
            ])
          )
          ||
          (
            existing().userId == request.auth.uid
            && existing().status == 'pending'
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isVerifiedUser() && isValidId(orderId) && isAdmin();
    }

    // ---------------------------------------------------------
    // 5. Immutable Inventory Movement Ledger (/inventoryLogs/{logId})
    // ---------------------------------------------------------
    match /inventoryLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isAdmin();
      allow list: if isSignedIn() && isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(logId)
        && isValidInventoryLog(incoming())
        && incoming().createdAt == request.time
        && isAdmin()
        && exists(/databases/$(database)/documents/products/$(incoming().productId));

      allow update: if false;
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // 6. Storefront Configuration (/settings/{settingId})
    // ---------------------------------------------------------
    match /settings/{settingId} {
      allow get: if settingId == 'store';
      allow list: if false;

      allow create: if isVerifiedUser()
        && settingId == 'store'
        && isValidStoreSettings(incoming())
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isVerifiedUser()
        && settingId == 'store'
        && isValidStoreSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'storeName', 'announcementText', 'announcementEnabled',
          'freeDeliveryThresholdUsd', 'standardShippingUsd', 'cadExchangeRate',
          'lowStockDefaultThreshold', 'supportEmail', 'updatedAt'
        ])
        && isAdmin();

      allow delete: if false;
    }
  }
}
